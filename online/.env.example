# Copie para .env (mesma pasta) e preencha. O .env real nunca vai pro Git.

POSTGRES_USER=gtranca
POSTGRES_DB=gtranca
POSTGRES_PASSWORD=mude-isto

# Segredo servico a servico (lobby/game/economy/admin-api). Gere com: openssl rand -hex 32
INTERNAL_SECRET=mude-isto-tambem

# Opcional: chave de assinatura do app (§18.2). Sem ela os servicos sobem sem verificar a assinatura
# (aviso no log, igual ao cluster). Mesmo valor de online.appKey no local.properties do app.
# Gere com: openssl rand -base64 32 | tr -d '=+/' | cut -c1-40
APP_SIGNING_KEY=

# Opcional: login Google do lobby-service. Sem isto a rota de login Google fica desligada.
GOOGLE_CLIENT_ID=

# Opcional: primeiro login da equipe no admin-api (§18.7). Sem isto nao tem como logar na primeira vez.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
