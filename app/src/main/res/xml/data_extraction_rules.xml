<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: o jogo salvo (cartas ocultas e a semente) nunca sai do aparelho, nem em backup nem na transferência. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="saved_game.json" />
        <exclude domain="file" path="saved_game.json.tmp" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="saved_game.json" />
        <exclude domain="file" path="saved_game.json.tmp" />
    </device-transfer>
</data-extraction-rules>
