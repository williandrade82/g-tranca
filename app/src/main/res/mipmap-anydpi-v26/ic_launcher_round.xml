<?xml version="1.0" encoding="utf-8"?>
<!-- Ícone na identidade do salão: coroa dourada com cartas (ic_launcher_art, dentro da zona segura) sobre o fundo azul
     royal com raios de holofote (ic_launcher_bg_art). O monocromático (ícones temáticos) continua com a coroa de contorno. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_bg_art" />
    <foreground android:drawable="@drawable/ic_launcher_art" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
